# Copy this file to .env.local for local development.
# In Vercel, enter these keys as production environment variables.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site
NEXT_PUBLIC_SITE_URL=https://anomalybox.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
INDEXNOW_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Anomaly Box <notifications@anomalybox.com>"

# Instagram / Meta (optional for connect)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://anomalybox.com/api/auth/instagram/callback
LINKED_ACCOUNT_TOKEN_SECRET=replace-with-a-long-random-32-plus-character-secret
INTERNAL_API_TOKEN=replace-with-a-long-random-32-plus-character-secret
ADMIN_API_TOKEN=replace-with-a-long-random-32-plus-character-secret
