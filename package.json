{
  "name": "anomalybox",
  "version": "1.0.0",
  "description": "Anomaly Box private creative direction platform",
  "private": true,
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node tools/generate-indexnow-file.mjs && python tools/generate-seo-markdown-map.py && node tools/check-seo-package-integrity.mjs && python tools/audit_editorial_quality.py && python tools/audit_content_readability.py",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib supabase/functions/admin-generation-batches/index.ts tools/*v2-2.ts tools/automatic-quality-regression.ts tools/eval-automatic-card-quality.ts tools/build-card-training.ts tools/eval-card-training.ts tools/check-card-edge-imports.mjs tests/card-training.test.ts tests/creative-taxonomy.test.ts tests/automatic-card-*.test.ts tests/helpers/card-edge-harness.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.quality.json",
    "sonar:scan": "npx -y @sonar/scan",
    "sonar:local": "powershell -ExecutionPolicy Bypass -File .\\tools\\run-sonar-scan.ps1 -Target local",
    "sonar:cloud": "powershell -ExecutionPolicy Bypass -File .\\tools\\run-sonar-scan.ps1 -Target cloud",
    "design:discover": "python .\\design-intelligence\\scripts\\discover_webui_candidates.py",
    "design:websight": "python .\\design-intelligence\\scripts\\discover_websight_patterns.py",
    "design:score": "python .\\design-intelligence\\scripts\\score_reference_candidates.py",
    "design:export": "python .\\design-intelligence\\scripts\\export_approved_references.py",
    "design:build": "python .\\design-intelligence\\scripts\\build_design_playbook.py",
    "design:refresh": "npm run design:discover && npm run design:websight && npm run design:score && npm run design:export && npm run design:build",
    "distribution:pdf": "node tools/export-presentation-pdf.mjs",
    "distribution:kit": "node tools/generate-platform-copy-kit.mjs",
    "distribution:indexnow": "node tools/ping-indexnow.mjs",
    "content:train": "python tools/build-seo-sft-dataset.py",
    "content:eval": "python tools/eval-seo-content-quality.py",
    "content:polish": "python tools/enhance_readability.py",
    "audit:leaks": "powershell -ExecutionPolicy Bypass -File .\\tools\\scan-production-leaks.ps1 -ScanApp",
    "audit:seo": "python tools/audit-public-seo.py",
    "audit:editorial": "python tools/audit_editorial_quality.py",
    "audit:readability": "python tools/audit_content_readability.py",
    "audit:live-content": "node tools/audit-live-public-content.mjs",
    "test:seo-package": "node tools/check-seo-package-integrity.mjs",
    "audit:consolidation": "node tools/check-consolidation-crawl.mjs",
    "audit:readiness": "powershell -ExecutionPolicy Bypass -File .\\tools\\test-production-readiness.ps1 -SkipSlow -SkipExportDryRun",
    "audit:env": "node tools/check-production-env.mjs",
    "audit:env:production": "node tools/check-production-env.mjs --production",
    "audit:env:vercel": "node tools/check-vercel-production-env.mjs",
    "test:card-cleanup": "node --experimental-strip-types tools/test-card-placeholder-cleanup.mjs",
    "test:idea-card": "tsx tools/test-idea-card-adapter.mjs && tsx tests/card-page-components.test.ts",
    "test:idea-card-quality": "tsx tools/eval-automatic-card-quality.ts && tsx tests/creative-taxonomy.test.ts && tsx tests/automatic-card-concept-ranking.test.ts && tsx tests/idea-card-quality-v2-2.test.ts && tsx tests/idea-card-duration-planner.test.ts && tsx tests/idea-card-review-policy.test.ts && tsx tests/automatic-card-policy.test.ts && tsx tests/automatic-card-stock-audit.test.ts && tsx tests/automatic-card-workflow.test.ts && npm run test:card-training && node tools/check-card-edge-imports.mjs",
    "test:idea-card-qualification": "tsx tools/eval-automatic-card-quality.ts && tsx tests/model-qualification-contract.test.ts && tsx tests/automatic-card-policy.test.ts",
    "test:idea-card-gold-optional": "tsx tools/eval-idea-card-quality.mjs --qualification",
    "test:card-embeddings": "python tests/test_card_embeddings.py",
    "test:automatic-quality-db": "powershell -NoProfile -Command \"Get-Content -Raw 'tools/test-automatic-card-quality.sql','tools/test-generation-integrity.sql' | docker exec -i supabase_db_ViralBox psql -U postgres -d postgres -v ON_ERROR_STOP=1 -f -; exit $LASTEXITCODE\"",
    "model:qualify-v2.2": "tsx tools/qualify-model-profile-v2-2.ts",
    "model:qualify-v3": "tsx tools/qualify-model-profile-v2-2.ts",
    "test:model-adapters": "tsx tests/model-provider-adapter.test.ts && tsx tests/model-qualification-contract.test.ts",
    "test:ai-residue": "tsx tests/ai-residue.test.ts",
    "audit:card-residue": "tsx tools/scan-card-ai-residue.ts",
    "stock:quarantine-residue": "tsx tools/quarantine-card-residue.ts --dry-run",
    "stock:quarantine-residue:apply": "tsx tools/quarantine-card-residue.ts --apply",
    "stock:audit-v2.2": "tsx tools/audit-card-stock-v2-2.ts",
    "stock:audit-v3": "tsx tools/audit-card-stock-v2-2.ts",
    "stock:quarantine-v3": "tsx tools/audit-card-stock-v2-2.ts",
    "stock:quarantine-v3:apply": "tsx tools/audit-card-stock-v2-2.ts --apply",
    "stock:rollback-v3": "tsx tools/audit-card-stock-v2-2.ts --rollback",
    "stock:rollback-v3:apply": "tsx tools/audit-card-stock-v2-2.ts --rollback --apply",
    "stock:restock-v3": "tsx tools/restock-pilot-v2-2.ts",
    "stock:quarantine-v2.2": "tsx tools/audit-card-stock-v2-2.ts",
    "stock:quarantine-v2.2:apply": "tsx tools/audit-card-stock-v2-2.ts --apply",
    "stock:rollback-v2.2": "tsx tools/audit-card-stock-v2-2.ts --rollback",
    "stock:rollback-v2.2:apply": "tsx tools/audit-card-stock-v2-2.ts --rollback --apply",
    "stock:restock-pilot-v2.2": "tsx tools/restock-pilot-v2-2.ts",
    "stock:fill": "tsx tools/fill-lane-persona-stock.ts --dry-run --target 10",
    "audit:idea-card-baseline": "tsx tools/measure-idea-card-quality-baseline.mjs --scan-latest",
    "lint:idea-card-templates": "node tools/lint-idea-card-templates.mjs",
    "audit:training-deep": "powershell -ExecutionPolicy Bypass -File .\\tools\\audit-training-deep.ps1",
    "eval:lora-idea-card": "tsx tools/eval-card-training.ts",
    "calibrate:gpu-idea-card": "python tools/calibrate-gpu-idea-card.py",
    "build:sft-idea-card": "tsx tools/build-card-training.ts",
    "test:card-training": "tsx tests/card-training.test.ts && python tests/test_card_sft_data.py",
    "test:store-search": "node --experimental-strip-types tools/test-store-category-search.mjs",
    "test:auth-smoke": "node tools/test-authenticated-creator-smoke.mjs",
    "test:route-smoke": "powershell -ExecutionPolicy Bypass -File .\\tools\\test-public-route-smoke.ps1",
    "audit:export-size": "powershell -ExecutionPolicy Bypass -File .\\tools\\check-export-size.ps1 -ScanLatestExport",
    "test:stripe-webhook": "node tools/test-stripe-webhook-replay.mjs",
    "stripe:setup": "node tools/setup-stripe-production.mjs",
    "stripe:setup:live": "node tools/setup-stripe-production.mjs --mode live --redeploy",
    "stripe:products": "node tools/sync-stripe-products.mjs --mode test",
    "stripe:products:live": "node tools/sync-stripe-products.mjs --mode live",
    "stripe:products:both": "node tools/sync-stripe-products.mjs --mode both",
    "stripe:promote:watch": "node tools/promote-stripe-live-when-ready.mjs",
    "stripe:promote:once": "node tools/promote-stripe-live-when-ready.mjs --once",
    "stripe:agent": "stripe agent setup -y",
    "stripe:agent:skills": "npx --yes skills add https://docs.stripe.com -y",
    "stripe:agent:status": "node tools/stripe-agent-status.mjs",
    "test:checkout-reservations": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Get-Content -Raw '.\\\\tools\\\\test-checkout-reservations.sql' | docker exec -i supabase_db_ViralBox psql -U postgres -d postgres\"",
    "demo:reset": "powershell -ExecutionPolicy Bypass -File .\\tools\\reset-demo-account.ps1 -MakeAdmin",
    "train:import-book-hv": "powershell -ExecutionPolicy Bypass -File .\\tools\\import-high-value-from-book.ps1 -Apply",
    "audit:finalist-sample": "powershell -ExecutionPolicy Bypass -File .\\tools\\sample-finalist-editorial.ps1 -ScanLatestExport",
    "test:perf": "node tools/audit-site-speed.mjs",
    "test:vitals": "node tools/measure-web-vitals.mjs",
    "test:e2e": "tsx tests/e2e-checkout-delivery.test.ts && tsx tests/e2e-creator-experience.test.ts && tsx tests/e2e-auth-protection.test.ts",
    "test:security": "tsx tests/security-rls-isolation.test.ts && node tools/audit-security-csp.mjs --allow-offline",
    "test:seo-full": "node tools/test-sitemap-crawler.mjs && node tools/test-structured-data.mjs",
    "test:a11y": "node tools/audit-accessibility.mjs",
    "test:stress": "node tools/stress-concurrent-checkout.mjs",
    "test:suite": "npm run test:e2e && npm run test:security && npm run test:stress",
    "test:live-suite": "npm run test:perf && npm run test:seo-full && npm run test:a11y",
    "test": "powershell -ExecutionPolicy Bypass -File .\\tools\\test-all.ps1 -SkipQualityGate"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.50.3",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "next": "^16.4.2",
    "postcss": "^8.5.24",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^4.6.0",
    "sharp": "0.35.5",
    "stripe": "^18.3.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "eslint": "^9.30.1",
    "eslint-config-next": "^16.4.2",
    "tsx": "^4.23.12"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.5"
  }
}
