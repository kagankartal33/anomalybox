{
  "name": "anomaly-box",
  "version": "1.0.0",
  "description": "Anomaly Box private creative direction platform",
  "private": true,
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib",
    "typecheck": "tsc --noEmit",
    "design:discover": "python .\\design-intelligence\\scripts\\discover_webui_candidates.py",
    "design:websight": "python .\\design-intelligence\\scripts\\discover_websight_patterns.py",
    "design:score": "python .\\design-intelligence\\scripts\\score_reference_candidates.py",
    "design:export": "python .\\design-intelligence\\scripts\\export_approved_references.py",
    "design:build": "python .\\design-intelligence\\scripts\\build_design_playbook.py",
    "design:refresh": "npm run design:discover && npm run design:websight && npm run design:score && npm run design:export && npm run design:build",
    "audit:leaks": "powershell -ExecutionPolicy Bypass -File .\\tools\\scan-production-leaks.ps1 -ScanApp",
    "audit:readiness": "powershell -ExecutionPolicy Bypass -File .\\tools\\test-production-readiness.ps1 -SkipSlow -SkipExportDryRun",
    "audit:env": "node tools/check-production-env.mjs",
    "audit:env:production": "node tools/check-production-env.mjs --production",
    "test:card-cleanup": "node --experimental-strip-types tools/test-card-placeholder-cleanup.mjs",
    "test:idea-card": "npx --yes tsx tools/test-idea-card-adapter.mjs",
    "test:store-search": "node --experimental-strip-types tools/test-store-category-search.mjs",
    "test:auth-smoke": "node tools/test-authenticated-creator-smoke.mjs",
    "test:route-smoke": "powershell -ExecutionPolicy Bypass -File .\\tools\\test-public-route-smoke.ps1",
    "audit:export-size": "powershell -ExecutionPolicy Bypass -File .\\tools\\check-export-size.ps1 -ScanLatestExport",
    "test:stripe-webhook": "node tools/test-stripe-webhook-replay.mjs",
    "demo:reset": "powershell -ExecutionPolicy Bypass -File .\\tools\\reset-demo-account.ps1 -MakeAdmin",
    "train:import-book-hv": "powershell -ExecutionPolicy Bypass -File .\\tools\\import-high-value-from-book.ps1 -Apply",
    "audit:finalist-sample": "powershell -ExecutionPolicy Bypass -File .\\tools\\sample-finalist-editorial.ps1 -ScanLatestExport",
    "test": "powershell -ExecutionPolicy Bypass -File .\\tools\\test-all.ps1 -SkipQualityGate"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.50.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "next": "^16.2.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^4.6.0",
    "stripe": "^18.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.1",
    "eslint-config-next": "^16.2.10",
    "postcss": "8.5.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}