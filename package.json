{
  "name": "anomaly-box",
  "version": "1.0.0",
  "description": "Anomaly Box private creative direction platform",
  "private": true,
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib",
    "typecheck": "tsc --noEmit",
    "design:discover": "python .\\design-intelligence\\scripts\\discover_webui_candidates.py",
    "design:websight": "python .\\design-intelligence\\scripts\\discover_websight_patterns.py",
    "design:score": "python .\\design-intelligence\\scripts\\score_reference_candidates.py",
    "design:export": "python .\\design-intelligence\\scripts\\export_approved_references.py",
    "design:build": "python .\\design-intelligence\\scripts\\build_design_playbook.py",
    "design:refresh": "npm run design:discover && npm run design:websight && npm run design:score && npm run design:export && npm run design:build",
    "audit:leaks": "powershell -ExecutionPolicy Bypass -File .\\tools\\scan-production-leaks.ps1 -ScanApp",
    "audit:readiness": "powershell -ExecutionPolicy Bypass -File .\\tools\\test-production-readiness.ps1 -SkipSlow -SkipExportDryRun",
    "audit:env": "node tools/check-production-env.mjs",
    "audit:env:production": "node tools/check-production-env.mjs --production",
    "test:store-search": "node tools/test-store-category-search.mjs",
    "test:auth-smoke": "node tools/test-authenticated-creator-smoke.mjs",
    "test:idea-card": "npx tsx tests/idea-card-quality-v2-2.test.ts",
    "test:duration": "npx tsx tests/idea-card-duration-planner.test.ts",
    "test:taxonomy": "npx tsx tests/creative-taxonomy.test.ts",
    "test:model-adapter": "npx tsx tests/model-provider-adapter.test.ts",
    "test:sft": "python -m unittest tests/test_card_sft_data.py",
    "test:all-units": "npx tsx tests/automatic-card-concept-ranking.test.ts && npx tsx tests/automatic-card-stock-audit.test.ts && npx tsx tests/card-training.test.ts && npx tsx tests/gold-rating-input.test.ts && npx tsx tests/gold-set-quota.test.ts && npx tsx tests/idea-card-duration-planner.test.ts && npx tsx tests/idea-card-quality-v2-2.test.ts && npx tsx tests/idea-card-review-policy.test.ts && npx tsx tests/model-provider-adapter.test.ts && npx tsx tests/model-qualification-contract.test.ts && python -m unittest tests/test_card_sft_data.py",
    "test:checkout-reservations": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Get-Content -Raw '.\\tools\\test-checkout-reservations.sql' | docker exec -i supabase_db_ViralBox psql -U postgres -d postgres\"",
    "test": "npm run test:all-units"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.50.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "next": "^16.2.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^4.6.0",
    "stripe": "^18.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.1",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8.5.24",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.3"
  }
}
